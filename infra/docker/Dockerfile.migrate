FROM node:20-alpine AS dependencies

WORKDIR /workspace

COPY auth-service/package*.json ./auth-service/
COPY orders-service/package*.json ./orders-service/
COPY payments-service/package*.json ./payments-service/
COPY notification-service/package*.json ./notification-service/
COPY tickets-service/package*.json ./tickets-service/

RUN set -eux; \
    for service in auth-service orders-service payments-service notification-service tickets-service; do \
      cd "/workspace/$service"; \
      npm ci; \
    done

FROM node:20-alpine AS runner

WORKDIR /workspace

COPY --from=dependencies /workspace ./
COPY auth-service/drizzle ./auth-service/drizzle
COPY auth-service/drizzle.config.ts ./auth-service/drizzle.config.ts
COPY auth-service/src/drizzle/schema.ts ./auth-service/src/drizzle/schema.ts
COPY orders-service/drizzle ./orders-service/drizzle
COPY orders-service/drizzle.config.ts ./orders-service/drizzle.config.ts
COPY orders-service/src/drizzle/schema.ts ./orders-service/src/drizzle/schema.ts
COPY payments-service/drizzle ./payments-service/drizzle
COPY payments-service/drizzle.config.ts ./payments-service/drizzle.config.ts
COPY payments-service/src/drizzle/schema.ts ./payments-service/src/drizzle/schema.ts
COPY notification-service/drizzle ./notification-service/drizzle
COPY notification-service/drizzle.config.ts ./notification-service/drizzle.config.ts
COPY notification-service/src/drizzle/schema.ts ./notification-service/src/drizzle/schema.ts
COPY tickets-service/drizzle ./tickets-service/drizzle
COPY tickets-service/drizzle.config.ts ./tickets-service/drizzle.config.ts
COPY tickets-service/src/drizzle/schema.ts ./tickets-service/src/drizzle/schema.ts
COPY infra/docker/run-migrations.sh /usr/local/bin/run-migrations

RUN chmod 0555 /usr/local/bin/run-migrations

USER node
ENTRYPOINT ["/usr/local/bin/run-migrations"]
