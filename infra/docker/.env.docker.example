# =============================================================================
# Docker Compose Environment Configuration
# Copy this file to .env.docker and fill in real values before running:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# !! EVERY value below is a deliberate non-functional placeholder. The services
# !! fail closed if you leave them as-is (auth-service refuses to boot with a
# !! placeholder JWT_SECRET, and the gateway refuses placeholder VNPay config in
# !! production). This is intentional: a placeholder that boots is worse than a
# !! crash, because the value is public in this repository.
#
# Generate real secrets with:
#   openssl rand -hex 32
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=railway_ticket_booking

# ---------- Redis ----------
# Use a random password. The Compose startup script injects it into Redis/Sentinel.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=railway
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-rabbit-password

# ---------- JWT ----------
# MUST be replaced. auth-service rejects any placeholder-shaped value and any
# secret shorter than 32 characters.
JWT_SECRET=replace-with-a-strong-random-secret

# ---------- API Gateway ----------
# Swagger documents the whole API to anonymous callers: keep it off in production.
ENABLE_SWAGGER=false
# Trusted reverse-proxy hops in front of the gateway (nginx = 1).
TRUST_PROXY=1

# ---------- VNPAY ----------
VNPAY_TMN_CODE=replace-with-live-vnpay-tmn-code
VNPAY_SECURE_SECRET=replace-with-live-vnpay-secret
VNPAY_HOST=https://pay.vnpay.vn/vpcpay.html
VNPAY_TEST_MODE=false
VNPAY_PUBLIC_BASE_URL=https://api.example.com
VNPAY_RETURN_URL=https://api.example.com/payments/vnpay/return

# ---------- Client / CORS ----------
NEXT_PUBLIC_API_URL=https://api.example.com
CLIENT_ORIGIN=https://app.example.com
CLIENT_URL=https://app.example.com

# ---------- Order Expiration ----------
ORDER_EXPIRATION_TTL_MS=600000

# ---------- SMTP (notification-service) ----------
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=no-reply@example.com

# ---------- AWS ECR ----------
ECR_REGISTRY=replace-with-your-12-digit-account-id.dkr.ecr.<region>.amazonaws.com/
ECR_REPOSITORY=railway-ticket_booking


