generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  ticketItemId         String    @map("ticket_item_id") @db.Uuid
  ticketId             String    @map("ticket_id") @db.Uuid
  ticketTitle          String    @map("ticket_title") @db.VarChar(180)
  trainNumber          String?   @map("train_number") @db.VarChar(64)
  departureStationCode String?   @map("departure_station_code") @db.VarChar(24)
  departureStationName String?   @map("departure_station_name") @db.VarChar(120)
  arrivalStationCode   String?   @map("arrival_station_code") @db.VarChar(24)
  arrivalStationName   String?   @map("arrival_station_name") @db.VarChar(120)
  departureTime        DateTime? @map("departure_time")
  arrivalTime          DateTime? @map("arrival_time")
  coachCode            String?   @map("coach_code") @db.VarChar(48)
  seatClass            String?   @map("seat_class") @db.VarChar(80)
  seatType             String?   @map("seat_type") @db.VarChar(80)
  quantity             Int
  unitPrice            BigInt    @map("unit_price")
  totalPrice           BigInt    @map("total_price")
  voucherId            String?   @map("voucher_id") @db.Uuid
  voucherCode          String?   @map("voucher_code") @db.VarChar(32)
  discountAmount       BigInt    @default(0) @map("discount_amount")
  ticketCode           String?   @unique @map("ticket_code") @db.VarChar(24)
  qrPayload            String?   @map("qr_payload") @db.VarChar(2000)
  idempotencyKey       String?   @unique @map("idempotency_key") @db.VarChar(64)
  contactEmail         String?   @map("contact_email") @db.VarChar(255)
  contactPhone         String?   @map("contact_phone") @db.VarChar(24)
  cancelReason         String?   @map("cancel_reason") @db.VarChar(255)
  status               Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  seatLabels OrderSeatLabel[]
  passengers OrderPassenger[]
  voucher    Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([ticketId])
  @@index([ticketItemId])
  @@index([voucherId])
  @@index([status])
  // Supports the expiration worker's predicate and oldest-first batch scan.
  @@index([status, deletedAt, createdAt, id], map: "orders_status_deleted_at_created_at_id_idx")
  @@map("orders")
}

model OrderSeatLabel {
  orderId   String @map("order_id") @db.Uuid
  seatLabel String @map("seat_label") @db.VarChar(32)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, seatLabel])
  @@map("order_seat_labels")
}

model OrderPassenger {
  orderId        String  @map("order_id") @db.Uuid
  fullName       String  @map("full_name") @db.VarChar(120)
  passengerType  String  @map("passenger_type") @db.VarChar(40)
  identityNumber String? @map("identity_number") @db.VarChar(40)
  phoneNumber    String? @map("phone_number") @db.VarChar(24)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, fullName, passengerType])
  @@map("order_passengers")
}

model Voucher {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(32)
  title          String    @db.VarChar(120)
  description    String?   @db.Text
  discountType   String    @map("discount_type") @db.VarChar(20)
  discountValue  BigInt    @map("discount_value")
  maxDiscount    BigInt?   @map("max_discount")
  minOrderAmount BigInt?   @map("min_order_amount")
  usageLimit     Int?      @map("usage_limit")
  usedCount      Int       @default(0) @map("used_count")
  validFrom      DateTime  @default(now()) @map("valid_from")
  validTo        DateTime  @map("valid_to")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  orders Order[]
  usages VoucherUsage[]

  @@index([code])
  @@index([isActive, validFrom, validTo])
  @@map("vouchers")
}

model VoucherUsage {
  id             String   @id @default(uuid()) @db.Uuid
  voucherId      String   @map("voucher_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  discountAmount BigInt   @map("discount_amount")
  usedAt         DateTime @default(now()) @map("used_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, orderId])
  @@index([userId])
  @@map("voucher_usages")
}
