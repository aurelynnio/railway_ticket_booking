# Database connection string. Replace placeholders with your actual values.
# Example: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://user:replace-with-password@localhost:5432/railway_notifications"
RABBITMQ_URL="amqp://localhost:5672"
CLIENT_URL="http://localhost:3000"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="replace-with-smtp-password"
EMAIL_FROM="no-reply@example.com"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="replace-with-supabase-publishable-key"
SUPABASE_SECRET_KEY="replace-with-supabase-secret-key"
