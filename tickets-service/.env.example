# MongoDB connection string. Replace placeholders with your actual values.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL="mongodb+srv://user:replace-with-password@cluster.mongodb.net/railway_ticket_tickets?retryWrites=true&w=majority"
RABBITMQ_URL="amqp://localhost:5672"
REDIS_HOST="your-redis-cloud-host"
REDIS_PORT="6379"
REDIS_PASSWORD="replace-with-redis-password"
REDIS_DB="0"
REDIS_CONNECT_TIMEOUT="10000"
