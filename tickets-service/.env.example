# PostgreSQL connection string (tickets-service now uses PostgreSQL).
# Example: postgresql://user:password@localhost:5432/railway_tickets
DATABASE_URL="postgresql://app:replace-with-password@localhost:5432/railway_tickets"
RABBITMQ_URL="amqp://localhost:5672"
REDIS_HOST="your-redis-cloud-host"
REDIS_PORT="6379"
REDIS_PASSWORD="replace-with-redis-password"
REDIS_DB="0"
REDIS_CONNECT_TIMEOUT="10000"

# Redis Sentinel mode (used by infra/docker/docker-compose.yml). When
# REDIS_SENTINELS is set it takes precedence over REDIS_HOST/REDIS_PORT.
REDIS_SENTINELS="redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379"
REDIS_SENTINEL_NAME="mymaster"
REDIS_SENTINEL_PASSWORD="replace-with-redis-password"
# Number of replicas attached to the master (2 replicas in the compose stack)
REDIS_REPLICA_COUNT="2"
