PORT="8080"
CLIENT_ORIGIN="http://localhost:3000"
RABBITMQ_URL="amqp://localhost:5672"
THROTTLER_LIMIT="10000"
THROTTLER_TTL="60000"
# Note: JWT verification is delegated to auth-service over RabbitMQ; api-gateway does not hold JWT_SECRET.
# Google OAuth is intentionally disabled until a real provider flow is implemented.
VNPAY_TMN_CODE="replace-with-vnpay-tmn-code"
VNPAY_SECURE_SECRET="replace-with-vnpay-secret"
VNPAY_HOST="https://sandbox.vnpayment.vn"
VNPAY_TEST_MODE="true"
# For local VNPay testing, set this to your tunnel URL such as https://abc.ngrok-free.app
VNPAY_PUBLIC_BASE_URL=""
VNPAY_RETURN_URL="http://localhost:8080/payments/vnpay/return"

# Object Storage (MinIO / S3) for user avatars and train images
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000/railway-media"
S3_BUCKET="railway-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_REGION="us-east-1"
